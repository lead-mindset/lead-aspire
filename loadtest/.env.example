# Copy to loadtest/.env (gitignored). Never commit real values.

# Supabase project used by the deployed backend.
SUPABASE_URL=https://<project-ref>.supabase.co
# Admin key: only create_test_users.py and cleanup.py use it.
SUPABASE_SERVICE_ROLE_KEY=
# Public key the browser uses for its own sign-in and the Storage upload.
SUPABASE_ANON_KEY=

# Deployed FastAPI backend (no trailing slash), e.g. https://lead-aspire-api.vercel.app
LOADTEST_HOST=

# Shared password for the 90 loadtestNN@test.lead accounts. Pick a long random one.
LOADTEST_PASSWORD=
