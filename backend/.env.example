SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_ORIGIN=http://localhost:3000
# Optional regex for more origins (e.g. Vercel preview URLs), anchored with ^ and $.
# Leave empty to allow only FRONTEND_ORIGIN.
FRONTEND_ORIGIN_REGEX=

# Microsoft Foundry agent (azure-ai-projects 2.x). Auth uses Entra ID through
# DefaultAzureCredential: `az login` locally, or AZURE_TENANT_ID /
# AZURE_CLIENT_ID / AZURE_CLIENT_SECRET in production.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_AGENT_NAME=
