# Lead Aspire backend settings (read by app/config.py and DefaultAzureCredential).
#
# Copy to .env (Copy-Item .env.example .env) and fill in. Never commit real values:
# backend/.env is gitignored.
#
# In Vercel these go only on the lead-aspire-api project, Production environment.
# Mark SUPABASE_SERVICE_ROLE_KEY and AZURE_CLIENT_SECRET as Sensitive.

# --- Supabase ---------------------------------------------------------------

# Project URL. Supabase dashboard > Project Settings > API.
SUPABASE_URL=https://<project-ref>.supabase.co

# service_role key. Supabase dashboard > Project Settings > API (not the anon key).
# It bypasses RLS: server only, it must never reach the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- CORS -------------------------------------------------------------------

# The exact frontend origin allowed to call the API (no trailing slash).
# Production: https://aspire.leadmindset.org
FRONTEND_ORIGIN=http://localhost:3000

# Optional regex for extra origins, used for the frontend's Vercel preview URLs.
# Leave empty locally. Production value:
# ^https://lead-aspire-(?:[a-z0-9]+|git-[a-z0-9-]+)-lead-admin-tech\.vercel\.app$
FRONTEND_ORIGIN_REGEX=

# --- Foundry (AI coach) ------------------------------------------------------
# Optional: without both values the API still runs and /api/coach/chat answers 503.
# The frontend shows the coach only when NEXT_PUBLIC_COACH_ENABLED=true.

# Foundry project endpoint, from the Foundry project in the LEAD Azure tenant
# (Overview page), e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=

# Name of the agent in that Foundry project.
FOUNDRY_AGENT_NAME=

# --- Azure service principal --------------------------------------------------
# Read by app/config.py and used to call Foundry (app/azure_auth.py). If any of the
# three is empty, the backend uses DefaultAzureCredential instead: locally that is
# your `az login` session, which must be in the same tenant as the Foundry project.
#
# From the lead-aspire-api app registration in Microsoft Entra ID. The app needs
# the Azure AI Developer role on the Foundry project.

# Directory (tenant) ID, from the app registration's Overview page.
AZURE_TENANT_ID=

# Application (client) ID, from the app registration's Overview page.
AZURE_CLIENT_ID=

# Client secret: use the secret's Value, not its Secret ID (Certificates & secrets).
# It expires: rotate it and update Vercel before its expiration date.
AZURE_CLIENT_SECRET=
