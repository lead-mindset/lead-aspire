# Copy to .env.local and fill in. Never commit real values.
# In Vercel, add NEXT_PUBLIC_* variables as type "Config" (not secret): they are sent to the browser by design.

# Optional sub-path to serve the app under (e.g. /aspire). Leave empty: the app runs at the
# root of aspire.leadmindset.org. Must match in .env.local and in Vercel (or be unset in both).
# No NEXT_PUBLIC_ prefix: next.config.ts inlines it into the build (it is part of every URL, not a secret).
BASE_PATH=

# Public origin users see, e.g. https://aspire.leadmindset.org (http://localhost:3000 locally).
# Not read by the code yet; reserved for absolute links such as auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# FastAPI backend origin for login and the New York app (https://api.aspire.leadmindset.org in Vercel).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project URL (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Project Settings > API). Safe for the browser; protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
