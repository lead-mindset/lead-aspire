# Copy to .env.local and fill in. Never commit real values.
# In Vercel, add NEXT_PUBLIC_* variables as type "Config" (not secret): they are sent to the browser by design.

# Route this app is served under by leadmain (Multi Zones), e.g. /talent, /pulse, /aspire.
# Leave empty to serve the app at the root. Must match in .env.local and in Vercel.
# No NEXT_PUBLIC_ prefix: next.config.ts inlines it into the build (it is part of every URL, not a secret).
BASE_PATH=

# FastAPI backend origin for login and the New York app.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project URL (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Project Settings > API). Safe for the browser; protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
